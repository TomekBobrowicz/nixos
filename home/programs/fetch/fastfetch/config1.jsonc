      "type": "os"
    },
    {
      "format": "{1} {2}",
      "key": " ",
      "type": "kernel"
    },
    {
      "key": " 󰅐",
      "type": "uptime"
    },
    {
      "key": " 󰔠",
      "text": "hourglass",
      "type": "command"
    },
    {
      "key": " ",
      "text": "hourglass -s 2026-07-26",
      "type": "command"
    },
    "break",
    {
      "key": " 󰾰",
      "type": "host"
    },
    {
      "key": " 󰻠",
      "type": "cpu"
    },
    {
      "key": " 󰍛",
      "type": "gpu"
    },
    {
      "key": " 󰨣",
      "type": "disk"
    },
    {
      "key": " ",
      "type": "memory"
    },
    "break",
    {
      "key": " 󰕮",
      "type": "de"
    },
    {
      "key": " ",
      "type": "wm"
    },
    {
      "key": " ",
      "type": "shell"
    },
    {
      "key": " ",
      "type": "terminal"
    },
    {
      "key": " 󰏖",
