    },
    "percent": {
      "type": 2
    },
    "separator": "  "
  },
  "logo": {
    "height": 10,
    "width": 25,
    "padding": {
      "left": 2,
      "top": 2
    },
    "source": "~/.config/fastfetch/nixos.png",
    "width": 22
  },
  "modules": [
    {
      "key": " ",
      "type": "title"
    },
    "break",
    {
